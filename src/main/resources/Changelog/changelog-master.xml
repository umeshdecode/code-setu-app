    <!-- 1. tblm_load_match                                     -->
    <!-- ===================================================== -->
    <changeSet id="CREATE_TBLM_LOAD_MATCH_01" author="Smart Load Matching">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not><tableExists tableName="tblm_load_match"/></not>
        </preConditions>
        <createTable tableName="tblm_load_match">
            <column name="load_match_id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="shipment_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="trip_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="overall_score" type="DOUBLE"/>
            <column name="route_score" type="DOUBLE"/>
            <column name="capacity_score" type="DOUBLE"/>
            <column name="weight_score" type="DOUBLE"/>
            <column name="timing_score" type="DOUBLE"/>
            <column name="vehicle_score" type="DOUBLE"/>
            <column name="handling_score" type="DOUBLE"/>
            <column name="status" type="VARCHAR(50)"/>
            <column name="expires_at" type="DATETIME"/>
            <column name="company_id" type="INT"/>
            <column name="is_active" type="BIT" defaultValueBoolean="true"/><column name="is_deleted" type="BIT" defaultValueBoolean="false"/>
            <column name="created_by" type="BIGINT"/><column name="created_by_name" type="VARCHAR(255)"/><column name="created_at" type="DATETIME"/>
            <column name="updated_by_id" type="BIGINT"/><column name="updated_by_name" type="VARCHAR(255)"/><column name="updated_at" type="DATETIME"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="tblm_load_match" baseColumnNames="shipment_id"
                                 referencedTableName="tblm_shipment" referencedColumnNames="shipment_id"
                                 constraintName="fk_load_match_shipment"/>
        <addForeignKeyConstraint baseTableName="tblm_load_match" baseColumnNames="trip_id"
                                 referencedTableName="tbl_trip" referencedColumnNames="trip_id"
                                 constraintName="fk_load_match_trip"/>
    </changeSet>

