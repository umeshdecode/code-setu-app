    <!-- ===================================================== -->
    <!-- 5. Seed request/accept/reject + manifest permissions   -->
    <!-- ===================================================== -->
    <changeSet id="LOADMATCH_MANIFEST_PERMISSIONS_SEED_01" author="Smart Load Matching">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="tblm_permissions"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM tblm_permissions WHERE code = 'LOADMATCH_REQUEST'
            </sqlCheck>
        </preConditions>

        <insert tableName="tblm_permissions">
            <column name="code" value="LOADMATCH_REQUEST"/><column name="name" value="Load Match Request"/><column name="description" value="Permission to request a suggested load match"/><column name="module" value="Load Matching Module"/><column name="is_active" valueBoolean="true"/><column name="is_deleted" valueBoolean="false"/><column name="created_by_name" value="SYSTEM-DEFAULT"/>
        </insert>
        <insert tableName="tblm_permissions">
            <column name="code" value="LOADMATCH_ACCEPT"/><column name="name" value="Load Match Accept"/><column name="description" value="Permission to accept a requested load match"/><column name="module" value="Load Matching Module"/><column name="is_active" valueBoolean="true"/><column name="is_deleted" valueBoolean="false"/><column name="created_by_name" value="SYSTEM-DEFAULT"/>
        </insert>
        <insert tableName="tblm_permissions">
            <column name="code" value="LOADMATCH_REJECT"/><column name="name" value="Load Match Reject"/><column name="description" value="Permission to reject a load match"/><column name="module" value="Load Matching Module"/><column name="is_active" valueBoolean="true"/><column name="is_deleted" valueBoolean="false"/><column name="created_by_name" value="SYSTEM-DEFAULT"/>
        </insert>
        <insert tableName="tblm_permissions">
            <column name="code" value="MANIFEST_READ"/><column name="name" value="Trip Manifest Read"/><column name="description" value="Permission to view a trip's shipment manifest"/><column name="module" value="Load Matching Module"/><column name="is_active" valueBoolean="true"/><column name="is_deleted" valueBoolean="false"/><column name="created_by_name" value="SYSTEM-DEFAULT"/>
        </insert>
        <insert tableName="tblm_permissions">
            <column name="code" value="MANIFEST_UPDATE"/><column name="name" value="Trip Manifest Update"/><column name="description" value="Permission to update a trip manifest entry's status or sequence"/><column name="module" value="Load Matching Module"/><column name="is_active" valueBoolean="true"/><column name="is_deleted" valueBoolean="false"/><column name="created_by_name" value="SYSTEM-DEFAULT"/>
        </insert>

        <!-- Map new permissions to SuperAdmin role -->
        <sql>
            INSERT INTO tblm_role_permissions (role_id, permission_id)
            SELECT r.role_id, p.permission_id
            FROM tblm_roles r
                     CROSS JOIN tblm_permissions p
            WHERE r.code = 'SUPERADMIN'
              AND p.code IN ('LOADMATCH_REQUEST', 'LOADMATCH_ACCEPT', 'LOADMATCH_REJECT', 'MANIFEST_READ', 'MANIFEST_UPDATE')
              AND NOT EXISTS (
                    SELECT 1 FROM tblm_role_permissions rp
                    WHERE rp.role_id = r.role_id AND rp.permission_id = p.permission_id
                );
        </sql>
    </changeSet>
