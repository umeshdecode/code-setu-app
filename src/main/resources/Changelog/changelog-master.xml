    <!-- ===================================================== -->
    <!-- 1. tblm_trip_shipment                                  -->
    <!-- ===================================================== -->
    <changeSet id="CREATE_TBLM_TRIP_SHIPMENT_01" author="Smart Load Matching">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not><tableExists tableName="tblm_trip_shipment"/></not>
        </preConditions>
        <createTable tableName="tblm_trip_shipment">
            <column name="trip_shipment_id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="trip_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="shipment_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="load_match_id" type="BIGINT"/>
            <column name="allocated_weight_kg" type="DOUBLE"/>
            <column name="allocated_volume_cbm" type="DOUBLE"/>
            <column name="sequence_order" type="INT"/>
            <column name="manifest_status" type="VARCHAR(50)"/>
            <column name="company_id" type="INT"/>
            <column name="is_active" type="BIT" defaultValueBoolean="true"/><column name="is_deleted" type="BIT" defaultValueBoolean="false"/>
            <column name="created_by" type="BIGINT"/><column name="created_by_name" type="VARCHAR(255)"/><column name="created_at" type="DATETIME"/>
            <column name="updated_by_id" type="BIGINT"/><column name="updated_by_name" type="VARCHAR(255)"/><column name="updated_at" type="DATETIME"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="tblm_trip_shipment" baseColumnNames="trip_id"
                                 referencedTableName="tbl_trip" referencedColumnNames="trip_id"
                                 constraintName="fk_trip_shipment_trip"/>
        <addForeignKeyConstraint baseTableName="tblm_trip_shipment" baseColumnNames="shipment_id"
                                 referencedTableName="tblm_shipment" referencedColumnNames="shipment_id"
                                 constraintName="fk_trip_shipment_shipment"/>
        <addForeignKeyConstraint baseTableName="tblm_trip_shipment" baseColumnNames="load_match_id"
                                 referencedTableName="tblm_load_match" referencedColumnNames="load_match_id"
                                 constraintName="fk_trip_shipment_load_match"/>
    </changeSet>

