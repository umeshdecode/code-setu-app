    <changeSet id="LOADMATCH_PERMISSIONS_SEED_01" author="Smart Load Matching">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="tblm_permissions"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM tblm_permissions WHERE code = 'SHIPMENT_CREATE'
            </sqlCheck>
        </preConditions>

        <insert tableName="tblm_permissions">
            <column name="code" value="SHIPMENT_CREATE"/><column name="name" value="Shipment Create"/><column name="description" value="Permission to create shipment requests"/><column name="module" value="Shipment Module"/><column name="is_active" valueBoolean="true"/><column name="is_deleted" valueBoolean="false"/><column name="created_by_name" value="SYSTEM-DEFAULT"/>
        </insert>
        <insert tableName="tblm_permissions">
            <column name="code" value="SHIPMENT_READ"/><column name="name" value="Shipment Read"/><column name="description" value="Permission to view shipment requests"/><column name="module" value="Shipment Module"/><column name="is_active" valueBoolean="true"/><column name="is_deleted" valueBoolean="false"/><column name="created_by_name" value="SYSTEM-DEFAULT"/>
        </insert>
        <insert tableName="tblm_permissions">
            <column name="code" value="SHIPMENT_UPDATE"/><column name="name" value="Shipment Update"/><column name="description" value="Permission to update shipment requests"/><column name="module" value="Shipment Module"/><column name="is_active" valueBoolean="true"/><column name="is_deleted" valueBoolean="false"/><column name="created_by_name" value="SYSTEM-DEFAULT"/>
        </insert>
        <insert tableName="tblm_permissions">
