    <!-- vehicle_manufacturer_models - reference/seed data for  -->
    <!-- the manufacturer -> model dropdown on the vehicle form. -->
    <!-- Curated general industry knowledge (Indian commercial   -->
    <!-- trucks), not sourced from any third-party API/scrape.   -->
    <!-- ===================================================== -->
    <changeSet id="CREATE_VEHICLE_MANUFACTURER_MODELS_01" author="Smart Load Matching">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not><tableExists tableName="vehicle_manufacturer_models"/></not>
        </preConditions>
        <createTable tableName="vehicle_manufacturer_models">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="manufacturer" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="model" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="vehicle_type_category" type="VARCHAR(50)"/>
        </createTable>
    </changeSet>

