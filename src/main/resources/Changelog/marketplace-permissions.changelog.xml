    <!-- Grant the new permissions to the SUPERADMIN role. -->
    <changeSet id="MARKETPLACE_PERMISSIONS_SUPERADMIN_BIND_02" author="cargosetu">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="tblm_role_permissions"/>
            <tableExists tableName="tblm_roles"/>
        </preConditions>
        <sql>
            INSERT INTO tblm_role_permissions (role_id, permission_id)
            SELECT r.role_id, p.permission_id
            FROM tblm_roles r
            CROSS JOIN tblm_permissions p
            WHERE r.code = 'SUPERADMIN'
              AND p.code LIKE 'MARKETPLACE\_%'
              AND NOT EXISTS (
                  SELECT 1 FROM tblm_role_permissions rp
                  WHERE rp.role_id = r.role_id AND rp.permission_id = p.permission_id
              );
        </sql>
    </changeSet>

