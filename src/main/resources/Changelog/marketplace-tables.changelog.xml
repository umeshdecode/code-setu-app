    <changeSet id="marketplace-019" author="cargosetu">
        <createTable tableName="marketplace_cash_collection">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="booking_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="trip_id" type="BIGINT"/>
            <column name="payer_company_id" type="INT"/>
            <column name="receiver_type" type="VARCHAR(20)"/>
            <column name="receiver_id" type="BIGINT"/>
            <column name="amount" type="DECIMAL(15,2)"/>
            <column name="payment_stage" type="VARCHAR(30)"/>
            <column name="receipt_no" type="VARCHAR(50)"/>
            <column name="proof_document" type="VARCHAR(500)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING"/>
            <column name="collected_at" type="DATETIME"/>
            <column name="verified_at" type="DATETIME"/>
            <column name="verified_by_staff_id" type="BIGINT"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>
    </changeSet>

    <changeSet id="marketplace-020" author="cargosetu">
