    <!-- ===================================================== -->
    <!-- 3. Seed SuperAdmin Role & Bind All Permissions        -->
    <!-- ===================================================== -->
    <changeSet id="RBAC_SUPERADMIN_ROLE_SEED_20260816_02" author="Umesh Sharma">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="tblm_roles"/>
            <tableExists tableName="tblm_permissions"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM tblm_roles WHERE code = 'SUPERADMIN'
            </sqlCheck>
        </preConditions>

        <insert tableName="tblm_roles">
            <column name="code" value="SUPERADMIN"/>
            <column name="role_name" value="Super admin"/>
            <column name="description" value="Super Admin role with full system access"/>
            <column name="scope" value="PLATFORM"/>
            <column name="is_show" valueBoolean="false"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="is_deleted" valueBoolean="false"/>
            <column name="created_by_name" value="SYSTEM-DEFAULT"/>
        </insert>

        <!-- Map all permissions to SuperAdmin role in tblm_role_permissions -->
        <sql>
            INSERT INTO tblm_role_permissions (role_id, permission_id)
            SELECT r.role_id, p.permission_id
            FROM tblm_roles r
            CROSS JOIN tblm_permissions p
            WHERE r.code = 'SUPERADMIN'
              AND NOT EXISTS (
                  SELECT 1 FROM tblm_role_permissions rp 
                  WHERE rp.role_id = r.role_id AND rp.permission_id = p.permission_id
              );
        </sql>
    </changeSet>

    <!-- ===================================================== -->
    <!-- 3. Seed SuperAdmin User & Map to SuperAdmin Role      -->
    <!-- ===================================================== -->
    <changeSet id="RBAC_SUPERADMIN_USER_SEED_20260816_03" author="Umesh Sharma">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="tblm_staff"/>
            <tableExists tableName="tblm_roles"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM tblm_staff WHERE user_name = 'SUPERADMIN'
            </sqlCheck>
        </preConditions>

        <insert tableName="tblm_staff">
            <column name="uuid" value="31201SUPERADMIN31201"/>
            <column name="user_name" value="SUPERADMIN"/>
            <column name="email" value="superadmin@cargosetu"/>
            <column name="first_name" value="super admin"/>
            <column name="last_name" value="super admin"/>
            <column name="mobile_code" value="+91"/>
            <column name="mobile_number" value="+++"/>
            <column name="password" value="$2a$10$c6yl2E/iNR99hiHKlg6zkOTJJAD48lhDxQzG5/3ByTMrdg/7XGrbm"/>
            <column name="staff_type" value="SUPERADMIN"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="is_deleted" valueBoolean="false"/>
        </insert>

        <!-- Map SUPERADMIN staff user to SUPERADMIN role -->
        <sql>
            INSERT INTO tblm_user_roles (staff_id, role_id)
            SELECT s.staff_id, r.role_id
            FROM tblm_staff s
            JOIN tblm_roles r ON r.code = 'SUPERADMIN'
            WHERE s.user_name = 'SUPERADMIN'
              AND NOT EXISTS (
                  SELECT 1 FROM tblm_user_roles ur 
                  WHERE ur.staff_id = s.staff_id AND ur.role_id = r.role_id
              );
        </sql>
    </changeSet>
