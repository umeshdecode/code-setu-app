<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- ===================================================== -->
    <!-- 1. Create vehicle_brands                               -->
    <!-- ===================================================== -->
    <changeSet id="CREATE_VEHICLE_BRANDS_01" author="CargoSetu">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not><tableExists tableName="vehicle_brands"/></not>
        </preConditions>
        <createTable tableName="vehicle_brands">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="slug" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_vehicle_brand_slug"/>
            </column>
            <column name="active" type="BIT" defaultValueBoolean="true"/>
            <column name="source" type="VARCHAR(100)"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>

    <!-- ===================================================== -->
    <!-- 2. Create vehicle_models                              -->
    <!-- ===================================================== -->
    <changeSet id="CREATE_VEHICLE_MODELS_01" author="CargoSetu">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not><tableExists tableName="vehicle_models"/></not>
        </preConditions>
        <createTable tableName="vehicle_models">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="brand_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_vehicle_model_brand" references="vehicle_brands(id)"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="slug" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="brand_vehicle_name" type="VARCHAR(255)"/>
            <column name="primary_slug" type="VARCHAR(255)"/>
            <column name="category" type="VARCHAR(100)"/>
            <column name="sub_category" type="VARCHAR(100)"/>
            <column name="series_name" type="VARCHAR(255)"/>
            <column name="series_slug" type="VARCHAR(255)"/>
            <column name="brochure_url" type="VARCHAR(1000)"/>
            <column name="source" type="VARCHAR(100)"/>
            <column name="source_product_id" type="VARCHAR(100)"/>
            <column name="active" type="BIT" defaultValueBoolean="true"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
        <addUniqueConstraint
                tableName="vehicle_models"
                columnNames="brand_id, slug"
                constraintName="uk_vehicle_model_brand_slug"/>
    </changeSet>

    <!-- ===================================================== -->
    <!-- 3. Create vehicle_specifications                      -->
    <!-- ===================================================== -->
    <changeSet id="CREATE_VEHICLE_SPECIFICATIONS_01" author="CargoSetu">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not><tableExists tableName="vehicle_specifications"/></not>
        </preConditions>
        <createTable tableName="vehicle_specifications">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="vehicle_model_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_vehicle_spec_model"
                             foreignKeyName="fk_vehicle_spec_model" references="vehicle_models(id)"/>
            </column>
            <!-- Engine -->
            <column name="engine_type" type="VARCHAR(255)"/>
            <column name="engine_cylinders" type="INT"/>
            <column name="engine_displacement_cc" type="INT"/>
            <column name="fuel_type" type="VARCHAR(100)"/>
            <column name="emission_norm" type="VARCHAR(100)"/>
            <column name="mileage_kmpl" type="DOUBLE"/>
            <column name="fuel_tank_capacity_litres" type="INT"/>
            <column name="torque_nm" type="DOUBLE"/>
            <column name="engine_power_hp" type="DOUBLE"/>
            <column name="engine_rpm" type="INT"/>
            <column name="max_speed_kmh" type="DOUBLE"/>
            <column name="gradeability" type="DOUBLE"/>

            <!-- Dimensions -->
            <column name="turning_radius_mm" type="INT"/>
            <column name="wheelbase_mm" type="INT"/>
            <column name="deck_length_mm" type="INT"/>
            <column name="ground_clearance_mm" type="INT"/>
            <column name="overall_width_mm" type="INT"/>
            <column name="overall_height_mm" type="INT"/>
            <column name="overall_length_mm" type="INT"/>

            <!-- Weight / loading -->
            <column name="kerb_weight_kg" type="INT"/>
            <column name="gvw_kg" type="INT"/>
            <column name="payload_kg" type="INT"/>
            <column name="gearbox" type="VARCHAR(255)"/>

            <!-- Axle / brake / suspension -->
            <column name="axle_config" type="VARCHAR(100)"/>
            <column name="front_axle" type="VARCHAR(255)"/>
            <column name="rear_axle" type="VARCHAR(255)"/>
            <column name="front_suspension" type="VARCHAR(255)"/>
            <column name="rear_suspension" type="VARCHAR(255)"/>
            <column name="brake_type" type="VARCHAR(255)"/>
            <column name="abs" type="BIT"/>

            <!-- Body / cabin -->
            <column name="chassis_type" type="VARCHAR(255)"/>
            <column name="cabin_type" type="VARCHAR(255)"/>
            <column name="body_option" type="VARCHAR(255)"/>
            <column name="seating_capacity" type="INT"/>

            <!-- Tyres -->
            <column name="tubeless_tyres" type="BIT"/>
            <column name="front_tyre" type="VARCHAR(100)"/>
            <column name="rear_tyre" type="VARCHAR(100)"/>
            <column name="number_of_tyres" type="INT"/>

            <!-- Pricing -->
            <column name="min_price" type="DECIMAL(15,2)"/>
            <column name="max_price" type="DECIMAL(15,2)"/>

            <column name="last_synced_at" type="DATETIME"/>
        </createTable>
    </changeSet>

    <!-- ===================================================== -->
    <!-- 4. Create vehicle_model_images                        -->
    <!-- ===================================================== -->
    <changeSet id="CREATE_VEHICLE_MODEL_IMAGES_01" author="CargoSetu">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not><tableExists tableName="vehicle_model_images"/></not>
        </preConditions>
        <createTable tableName="vehicle_model_images">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="vehicle_model_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_vehicle_model_image" references="vehicle_models(id)"/>
            </column>
            <column name="image_url" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="display_order" type="INT"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>
    </changeSet>

    <!-- ===================================================== -->
    <!-- 5. Add vehicle_model_id to vehicles table             -->
    <!-- ===================================================== -->
    <changeSet id="ADD_VEHICLE_MODEL_ID_TO_VEHICLES_01" author="CargoSetu">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="vehicles"/>
            <not><columnExists tableName="vehicles" columnName="vehicle_model_id"/></not>
        </preConditions>
        <addColumn tableName="vehicles">
            <column name="vehicle_model_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint
                baseTableName="vehicles"
                baseColumnNames="vehicle_model_id"
                constraintName="fk_vehicles_vehicle_model"
                referencedTableName="vehicle_models"
                referencedColumnNames="id"/>
    </changeSet>

